# FitCheck Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database configuration
# Local Development (Default SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./fitcheck.db
#
# Production Managed PostgreSQL (Supabase / Neon):
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Note: You can paste either "postgresql://..." or "postgresql+asyncpg://..." - FitCheck auto-normalizes it.
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@db.padshivenguwbzhoyckt.supabase.co:5432/postgres
# Or Connection Pooler (Port 6543 - recommended for serverless deployments):
# DATABASE_URL=postgresql+asyncpg://postgres.padshivenguwbzhoyckt:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./fitcheck.db

# Storage configuration (local or s3)
STORAGE_TYPE=local
STORAGE_DIR=storage_data

# Optional: Google Gemini API Key for multimodal VLM
# If left blank, FitCheck automatically runs on its local CV & fashion heuristics engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PREFER_LOCAL_CV=false

# Supabase Authentication (for production user login)
# Found in: Supabase Dashboard -> Project Settings -> API / JWT Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
AUTH_REQUIRED=false

