# FitCheck Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database (defaults to local SQLite if unspecified)
DATABASE_URL=sqlite+aiosqlite:///./fitcheck.db

# Storage configuration (local or s3)
STORAGE_TYPE=local
STORAGE_DIR=storage_data

# Optional: Google Gemini API Key for multimodal VLM
# If left blank, FitCheck automatically runs on its local CV & fashion heuristics engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PREFER_LOCAL_CV=false

